[Unit]
Description=Lunae backend (Gunicorn)
After=network.target

[Service]
Type=simple
User=lunae
WorkingDirectory=/home/lunae/app
EnvironmentFile=/home/lunae/app/.env
ExecStart=/home/lunae/app/.venv/bin/gunicorn api.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 9 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
